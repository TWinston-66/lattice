From e84cd4faae1ff0253d6dab82adcf9d2fac4c89b7 Mon Sep 17 00:00:00 2001
From: Sai Asish Y <say.apm35@gmail.com>
Date: Sun, 16 Aug 2026 02:48:34 -0700
Subject: [PATCH] output: do not re-enable outputs while shutting down

Signed-off-by: Sai Asish Y <say.apm35@gmail.com>
---
 output.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/output.c b/output.c
index df932ddd..d27446f0 100644
--- a/output.c
+++ b/output.c
@@ -216,7 +216,8 @@ output_destroy(struct cg_output *output)
 
 	if (wl_list_empty(&server->outputs) && was_nested_output) {
 		server_terminate(server);
-	} else if (server->output_mode == CAGE_MULTI_OUTPUT_MODE_LAST && !wl_list_empty(&server->outputs)) {
+	} else if (server->output_mode == CAGE_MULTI_OUTPUT_MODE_LAST && !wl_list_empty(&server->outputs) &&
+		   !server->terminated) {
 		struct cg_output *prev = wl_container_of(server->outputs.next, prev, link);
 		output_enable(prev);
 		view_position_all(server);
